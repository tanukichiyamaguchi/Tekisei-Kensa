      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
      "questionNo": 117,
      "text": "計画的に仕事をする方だ",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
      "questionNo": 118,
      "text": "人間の本心は自己中心的で身勝手だと思う",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
      "questionNo": 119,
      "text": "心を傷つけられやすい方だと思う",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
      "questionNo": 120,
      "text": "新しい環境にもすぐなじめる方だ",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
      "questionNo": 121,
      "text": "相手のミスや欠点によく気がつく",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 2
    },
    {
