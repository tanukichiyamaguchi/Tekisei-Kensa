      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 1
    },
    {
      "questionNo": 114,
      "text": "過去の失敗を思い出してたびたび悲しくなる",
      "isActive": true,
      "isScored": true,
      "step": 4,
      "page": 1
    },
    {
      "questionNo": 115,
